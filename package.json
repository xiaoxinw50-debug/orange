{
  "name": "orange-memories",
  "version": "2.1.0",
  "description": "橙心回忆 - 专属琉璃城堡",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "mobile:prepare": "node scripts/prepare-mobile-web.js",
    "mobile:sync": "npm run mobile:prepare && npx cap sync",
    "mobile:add:android": "npm run mobile:prepare && npx cap add android",
    "mobile:add:ios": "npm run mobile:prepare && npx cap add ios",
    "mobile:build:android:release": "bash scripts/build-android-release.sh",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "mongoose": "^8.0.0",
    "cloudinary": "^1.41.0",
    "multer-storage-cloudinary": "^4.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "typescript": "^5.9.2"
  }
}
